<% content_for :title, "御見積書 - #{@estimate.subject}" %>

<div class="w-full max-w-2xl mx-auto">

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

    <%# タイトルヘッダー %>
    <div class="px-7 pt-8 pb-6 text-center border-b border-gray-100">
      <p class="text-xs tracking-widest text-gray-400 mb-2">ESTIMATE</p>
      <h1 class="text-2xl font-medium text-gray-700" style="font-family: 'Shippori Mincho', serif; letter-spacing: 0.5em;">御　見　積　書</h1>
      <div class="mt-3 flex items-center gap-3 justify-center">
        <div class="h-px flex-1 bg-gray-200"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>
    </div>

    <div class="p-6 space-y-6">

      <%# 宛先・発行情報 %>
      <div class="flex justify-between items-end gap-4">
        <div>
          <div class="text-xs text-gray-400 mb-1.5 tracking-wide">お客様名</div>
          <div class="text-lg font-medium text-gray-800 border-b border-gray-400 pb-1.5 min-w-40">
            <%= @estimate.client_name.presence || "　" %>　様
          </div>
        </div>
        <div class="text-xs text-gray-400 flex-shrink-0">
          <div class="text-sm font-bold text-gray-800 mb-2 text-right">長島開発</div>
          <div class="flex flex-wrap gap-x-4 gap-y-1 justify-end">
            <div><%= @estimate.doc_date.strftime("%Y年%-m月%-d日") %></div>

            <% if @estimate.doc_number.present? %>
              <div>No. <%= @estimate.doc_number %></div>
            <% end %>
            <div class="text-gray-600 font-medium"><%= @project.name %></div>
          </div>
        </div>
      </div>

      <% if @estimate.subject.present? %>
        <div class="border-l-2 border-gray-300 pl-4 py-0.5">
          <span class="text-xs text-gray-400">件名</span>
          <div class="text-sm font-medium text-gray-700 mt-0.5"><%= @estimate.subject %></div>
        </div>
      <% end %>

      <%# 明細（カード） %>
      <div class="space-y-1 border-t border-gray-100 pt-4">
        <% @estimate.items.each do |item| %>
          <% next if item["description"].blank? && item["unit_price"].to_f == 0 %>
          <% qty = item["qty"].to_f; price = item["unit_price"].to_f %>
          <% unit_prices = item["unit_prices"] %>
          <% multi = unit_prices.present? && unit_prices.length > 1 %>
          <% amt = multi ? unit_prices.sum { |p| p.to_f.round } : (qty * price).round %>
          <% mats = item["materials"].presence || (item["material_name"].present? ? [{"name"=>item["material_name"],"cost"=>item["material_cost"]}] : []) %>
          <% mats = mats.select { |m| m["name"].present? || m["cost"].to_i > 0 } %>

          <div class="py-3 border-b border-gray-100 last:border-b-0">
            <div class="flex justify-between items-baseline gap-4">
              <span class="text-sm text-gray-700 font-medium">
                <%= item["description"] %><% if item["note"].present? %><span class="text-xs text-gray-400 font-normal">　（<%= item["note"] %>）</span><% end %>
              </span>
              <span class="text-sm font-bold text-gray-800 flex-shrink-0"><%= amt > 0 ? "¥#{number_with_delimiter(amt)}" : "" %></span>
            </div>

            <div class="mt-1.5 space-y-0.5">
              <% unless multi %>
                <% if qty > 0 || price > 0 %>
                  <% qty_s = qty > 0 ? "#{qty % 1 == 0 ? qty.to_i : qty}#{item["unit"]}" : "" %>
                  <% price_s = price > 0 ? "¥#{number_with_delimiter(price.to_i)}" : "" %>
                  <% unit_sfx = item["unit"].present? && price > 0 ? "/#{item["unit"]}" : "" %>
                  <% detail = qty > 0 && price > 0 ? "#{qty_s} × #{price_s}#{unit_sfx}" : (qty > 0 ? qty_s : price_s) %>
                  <div class="text-xs text-gray-400 border-l border-gray-200 pl-2.5">
                    <%= detail %>
                  </div>
                <% end %>
              <% end %>
              <% if multi %>
                <% unit_prices.each_with_index do |p, i| %>
                  <div class="flex justify-between text-sm text-gray-600 border-l border-gray-300 pl-2.5">
                    <span>人工<%= %w[① ② ③ ④ ⑤ ⑥ ⑦ ⑧ ⑨ ⑩][i] %></span>
                    <span>¥<%= number_with_delimiter(p.to_f.round) %></span>
                  </div>
                <% end %>
              <% end %>

              <% mats.each do |m| %>
                <div class="flex justify-between text-sm text-gray-600 border-l border-stone-400 pl-2.5">
                  <span><%= m["name"].presence || "—" %><%= m["qty"].present? ? "　#{m["qty"]}" : "" %></span>
                  <span><%= m["cost"].to_i > 0 ? "¥#{number_with_delimiter(m["cost"].to_i)}" : "" %></span>
                </div>
              <% end %>
            </div>

          </div>
        <% end %>
      </div>

      <%# 合計 %>
      <div class="space-y-2 border-t border-gray-100 pt-4">
        <div class="flex justify-between text-sm">
          <span class="text-gray-400">施工費小計</span>
          <span class="text-gray-600">¥<%= number_with_delimiter(@estimate.work_subtotal) %></span>
        </div>
        <% if @estimate.material_subtotal > 0 %>
          <div class="flex justify-between text-sm">
            <span class="text-gray-400">資材費小計</span>
            <span class="text-gray-600">¥<%= number_with_delimiter(@estimate.material_subtotal) %></span>
          </div>
        <% end %>
        <% if @estimate.apply_tax %>
          <div class="flex justify-between text-sm border-b border-gray-100 pb-3">
            <span class="text-gray-400">消費税（10%）</span>
            <span class="text-gray-600">¥<%= number_with_delimiter(@estimate.tax) %></span>
          </div>
        <% else %>
          <div class="border-b border-gray-100 pb-3"></div>
        <% end %>
        <div class="flex justify-between items-end pt-1">
          <span class="text-sm text-gray-600 font-medium tracking-wide" style="letter-spacing: 0.05em;">合　計　金　額</span>
          <span class="text-2xl font-bold text-gray-800">¥<%= number_with_delimiter(@estimate.grand_total) %></span>
        </div>
      </div>

      <%# 備考 %>
      <% if @estimate.note.present? %>
        <div class="border-t border-gray-100 pt-4">
          <div class="text-xs text-gray-400 mb-1.5 tracking-wide">備考・条件</div>
          <p class="text-sm text-gray-500 whitespace-pre-wrap leading-relaxed"><%= @estimate.note %></p>
        </div>
      <% end %>

      <%# 発行者 %>
      <div class="text-center text-xs text-gray-300 pt-2 border-t border-gray-100">
        環境整備事業
      </div>

    </div>
  </div>

  <%# PDFボタン %>
  <div class="mt-4 flex gap-3 justify-center">
    <%= link_to "PDFとして保存", public_estimate_print_path(@estimate.share_token),
          target: "_blank",
          class: "px-5 py-3 bg-green-700 text-white rounded-lg text-sm font-medium hover:bg-green-600 active:bg-green-800" %>
  </div>

</div>

<style>
  @media print {
    .no-print { display: none !important; }
    body { background: white; }
  }
</style>
