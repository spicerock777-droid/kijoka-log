<% content_for :title, "御見積書 - #{@estimate.subject}" %>

<div class="w-full max-w-2xl mx-auto">

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">

    <%# ヘッダー %>
    <div class="bg-green-900 text-white px-6 py-5 text-center">
      <div class="text-xs tracking-widest text-green-300 mb-1">環境整備事業</div>
      <div class="text-2xl font-bold" style="letter-spacing: 0.3em;">御　見　積　書</div>
    </div>

    <div class="p-5 space-y-5">

      <%# 基本情報 %>
      <div class="flex justify-between items-start gap-4">
        <div>
          <div class="text-xs text-green-700 mb-0.5">お客様名</div>
          <div class="text-lg font-bold text-green-900 border-b border-green-900 pb-1">
            <%= @estimate.client_name.presence || "　" %>　様
          </div>
        </div>
        <div class="text-right text-xs text-gray-500 space-y-1 flex-shrink-0">
          <div><%= @estimate.doc_date.strftime("%Y年%-m月%-d日") %></div>
          <div>有効期限：30日間</div>
          <% if @estimate.doc_number.present? %>
            <div>No. <%= @estimate.doc_number %></div>
          <% end %>
          <div class="text-green-700 font-medium"><%= @project.name %></div>
        </div>
      </div>

      <% if @estimate.subject.present? %>
        <div class="bg-green-50 border border-green-200 rounded-md px-4 py-2.5 text-sm font-bold text-green-900">
          <%= @estimate.subject %>
        </div>
      <% end %>

      <%# 明細（スマホ用カード） %>
      <div class="space-y-2">
        <% @estimate.items.each do |item| %>
          <% next if item["description"].blank? && item["unit_price"].to_f == 0 %>
          <% qty = item["qty"].to_f; price = item["unit_price"].to_f; amt = (qty * price).round %>
          <% mat_cost = item["material_cost"].to_i %>
          <div class="bg-gray-50 border border-gray-100 rounded-lg px-4 py-3">
            <div class="font-medium text-green-900 text-sm mb-1"><%= item["description"] %></div>
            <div class="flex justify-between items-center text-xs text-gray-500">
              <span><%= qty > 0 ? "#{qty.to_i} #{item["unit"]}" : "" %> × ¥<%= number_with_delimiter(price.to_i) %></span>
              <span class="text-base font-bold text-green-800"><%= amt > 0 ? "¥#{number_with_delimiter(amt)}" : "" %></span>
            </div>
            <% if item["material_name"].present? || mat_cost > 0 %>
              <div class="flex justify-between items-center text-xs text-amber-600 mt-1 pt-1 border-t border-amber-100">
                <span>資材：<%= item["material_name"].presence || "—" %></span>
                <span class="font-medium"><%= mat_cost > 0 ? "¥#{number_with_delimiter(mat_cost)}" : "" %></span>
              </div>
            <% end %>
            <% if item["note"].present? %>
              <div class="text-xs text-gray-400 mt-1"><%= item["note"] %></div>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# 合計 %>
      <div class="bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
        <div class="flex justify-between px-4 py-2.5 border-b border-gray-200 text-sm">
          <span class="text-gray-500">施工費小計</span>
          <span class="font-medium">¥<%= number_with_delimiter(@estimate.work_subtotal) %></span>
        </div>
        <% if @estimate.material_subtotal > 0 %>
          <div class="flex justify-between px-4 py-2.5 border-b border-gray-200 text-sm">
            <span class="text-amber-600">資材費小計</span>
            <span class="font-medium text-amber-600">¥<%= number_with_delimiter(@estimate.material_subtotal) %></span>
          </div>
        <% end %>
        <div class="flex justify-between px-4 py-2.5 border-b border-gray-200 text-sm">
          <span class="text-gray-500">消費税（10%）</span>
          <span class="font-medium">¥<%= number_with_delimiter(@estimate.tax) %></span>
        </div>
        <div class="flex justify-between px-4 py-4 bg-green-900 text-white">
          <span class="font-bold">合計金額</span>
          <span class="font-bold text-xl">¥<%= number_with_delimiter(@estimate.grand_total) %></span>
        </div>
      </div>

      <%# 備考 %>
      <% if @estimate.note.present? %>
        <div class="border border-gray-200 rounded-lg p-4">
          <div class="text-xs font-bold text-gray-500 mb-1">備考・条件</div>
          <p class="text-sm text-gray-600 whitespace-pre-wrap"><%= @estimate.note %></p>
        </div>
      <% end %>

      <%# 発行者 %>
      <div class="text-center text-xs text-gray-400 pt-2 border-t border-gray-100">
        環境整備事業
      </div>

    </div>
  </div>
</div>
