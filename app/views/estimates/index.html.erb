<% content_for :title, "書類一覧" %>

<div class="w-full">
  <h1 class="font-bold text-2xl text-green-900 mb-5">書類一覧</h1>

  <%# タブ %>
  <div class="flex gap-0 mb-6 border-b border-gray-200">
    <%= link_to documents_path(tab: "estimates"),
        class: "px-5 py-2.5 text-sm font-medium border-b-2 -mb-px #{@tab == 'estimates' ? 'border-green-700 text-green-800' : 'border-transparent text-gray-400 hover:text-gray-600'}" do %>
      見積書 <span class="ml-1 text-xs opacity-60"><%= @estimates.size %></span>
    <% end %>
    <%= link_to documents_path(tab: "invoices"),
        class: "px-5 py-2.5 text-sm font-medium border-b-2 -mb-px #{@tab == 'invoices' ? 'border-green-700 text-green-800' : 'border-transparent text-gray-400 hover:text-gray-600'}" do %>
      請求書 <span class="ml-1 text-xs opacity-60"><%= @invoices.size %></span>
    <% end %>
    <%= link_to documents_path(tab: "receipts"),
        class: "px-5 py-2.5 text-sm font-medium border-b-2 -mb-px #{@tab == 'receipts' ? 'border-green-700 text-green-800' : 'border-transparent text-gray-400 hover:text-gray-600'}" do %>
      領収書 <span class="ml-1 text-xs opacity-60"><%= @receipts.size %></span>
    <% end %>
  </div>

  <%# 見積書タブ %>
  <% if @tab == "estimates" %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-5">
      <div class="text-sm font-medium text-green-800 mb-3">現場を選んで見積書を作成</div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% @projects.each do |project| %>
          <%= link_to new_project_estimate_path(project),
              class: "flex items-center justify-center gap-1 rounded-md px-3 py-2 bg-white border border-green-300 text-sm font-medium text-green-800 hover:bg-green-100 text-center" do %>
            ＋ <%= project.name %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @estimates.empty? %>
      <p class="text-center my-10 text-gray-400">見積書がありません。</p>
    <% else %>
      <div class="space-y-2">
        <% @estimates.each do |estimate| %>
          <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs bg-green-100 text-green-800 px-2 py-0.5 rounded-full"><%= estimate.project.name %></span>
                  <span class="text-xs text-gray-400"><%= estimate.doc_date.strftime("%Y年%-m月%-d日") %></span>
                </div>
                <div class="font-medium text-green-900"><%= estimate.client_name.presence || "（お客様名未入力）" %></div>
                <div class="text-sm text-gray-500 mt-0.5"><%= estimate.subject.presence || "（件名未入力）" %></div>
              </div>
              <div class="text-right flex-shrink-0 ml-4">
                <div class="font-bold text-green-800">¥<%= number_with_delimiter(estimate.grand_total) %></div>
                <%= link_to "詳細", project_estimate_path(estimate.project, estimate), class: "text-xs text-green-700 hover:underline" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  <%# 請求書タブ %>
  <% elsif @tab == "invoices" %>
    <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4 mb-5">
      <div class="text-sm font-medium text-emerald-800 mb-3">現場を選んで請求書を作成</div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% @projects.each do |project| %>
          <%= link_to new_project_invoice_path(project),
              class: "flex items-center justify-center gap-1 rounded-md px-3 py-2 bg-white border border-emerald-300 text-sm font-medium text-emerald-800 hover:bg-emerald-100 text-center" do %>
            ＋ <%= project.name %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @invoices.empty? %>
      <p class="text-center my-10 text-gray-400">請求書がありません。</p>
    <% else %>
      <div class="space-y-2">
        <% @invoices.each do |invoice| %>
          <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full"><%= invoice.project.name %></span>
                  <span class="text-xs text-gray-400"><%= invoice.invoiced_on.strftime("%Y年%-m月%-d日") %></span>
                </div>
                <div class="font-medium text-gray-800"><%= invoice.client_name.presence || "（お客様名未入力）" %></div>
                <div class="text-sm text-gray-500 mt-0.5"><%= invoice.subject.presence || "（件名未入力）" %></div>
              </div>
              <div class="text-right flex-shrink-0 ml-4">
                <div class="font-bold text-emerald-800">¥<%= number_with_delimiter(invoice.amount) %></div>
                <%= link_to "詳細", project_invoice_path(invoice.project, invoice), class: "text-xs text-emerald-700 hover:underline" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  <%# 領収書タブ %>
  <% elsif @tab == "receipts" %>
    <div class="bg-stone-50 border border-stone-200 rounded-lg p-4 mb-5">
      <div class="text-sm font-medium text-stone-700 mb-3">現場を選んで領収書を作成</div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% @projects.each do |project| %>
          <%= link_to new_project_receipt_path(project),
              class: "flex items-center justify-center gap-1 rounded-md px-3 py-2 bg-white border border-stone-300 text-sm font-medium text-stone-700 hover:bg-stone-100 text-center" do %>
            ＋ <%= project.name %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @receipts.empty? %>
      <p class="text-center my-10 text-gray-400">領収書がありません。</p>
    <% else %>
      <div class="space-y-2">
        <% @receipts.each do |receipt| %>
          <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs bg-stone-100 text-stone-700 px-2 py-0.5 rounded-full"><%= receipt.project.name %></span>
                  <span class="text-xs text-gray-400"><%= receipt.received_on.strftime("%Y年%-m月%-d日") %></span>
                </div>
                <div class="font-medium text-gray-800"><%= receipt.client_name.presence || "（お客様名未入力）" %></div>
                <div class="text-sm text-gray-500 mt-0.5"><%= receipt.tadashi.presence || "" %></div>
              </div>
              <div class="text-right flex-shrink-0 ml-4">
                <div class="font-bold text-stone-700">¥<%= number_with_delimiter(receipt.amount) %></div>
                <%= link_to "詳細", project_receipt_path(receipt.project, receipt), class: "text-xs text-stone-600 hover:underline" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
