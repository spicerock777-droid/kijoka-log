<% content_for :title, "請求書" %>

<div class="w-full max-w-lg">
  <div class="mb-4 flex justify-end no-print">
    <button onclick="window.print()" class="text-sm px-3 py-1.5 bg-green-700 text-white hover:bg-green-600 rounded-md">印刷 / PDF</button>
  </div>

  <div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden" id="invoice-print" style="-webkit-print-color-adjust: exact; print-color-adjust: exact;">

    <div class="text-center py-8 px-10 bg-gradient-to-r from-green-50 to-emerald-50">
      <p class="text-xs tracking-widest text-gray-400 mb-2">INVOICE</p>
      <h1 class="text-2xl font-medium text-gray-700" style="font-family: 'Shippori Mincho', serif; letter-spacing: 0.5em;">請　求　書</h1>
      <div class="mt-3 flex items-center gap-3 justify-center">
        <div class="h-px flex-1 bg-gray-300 opacity-40"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-gray-400 opacity-40"></div>
        <div class="h-px flex-1 bg-gray-300 opacity-40"></div>
      </div>
    </div>

    <div class="px-10 py-8 space-y-6">

      <div class="flex justify-between items-end">
        <div>
          <div class="text-xs text-gray-400 mb-1.5 tracking-wide">お客様名</div>
          <div class="text-xl font-medium text-gray-800 border-b border-gray-400 pb-1.5 min-w-52">
            <%= @invoice.client_name.presence || "　" %>　様
          </div>
        </div>
        <div class="text-xs text-gray-400 space-y-1.5 text-right">
          <div>請求日：<span class="text-gray-600"><%= @invoice.invoiced_on.strftime("%Y年%-m月%-d日") %></span></div>
          <% if @invoice.due_date.present? %>
            <div>支払期限：<span class="text-gray-600"><%= @invoice.due_date.strftime("%Y年%-m月%-d日") %></span></div>
          <% end %>
          <div>現場：<span class="text-gray-700 font-medium"><%= @project.name %></span></div>
        </div>
      </div>

      <% if @invoice.subject.present? %>
        <div class="border-l-2 border-gray-300 pl-4 py-0.5">
          <span class="text-xs text-gray-400">件名</span>
          <div class="text-sm font-medium text-gray-700 mt-0.5"><%= @invoice.subject %></div>
        </div>
      <% end %>

      <div class="text-center py-6 border-y border-gray-200">
        <div class="text-xs text-gray-400 mb-2 tracking-wide">ご請求金額</div>
        <div class="text-4xl font-bold text-gray-800" style="font-family: 'Shippori Mincho', serif;">
          ¥<%= number_with_delimiter(@invoice.amount) %>－
        </div>
        <div class="text-xs text-gray-400 mt-1">（税込）</div>
      </div>

      <div class="text-center text-sm text-gray-500">
        上記の金額をご請求申し上げます。
      </div>

      <% if @invoice.note.present? %>
        <div class="border-t border-gray-100 pt-4 text-xs text-gray-400">
          <span class="mr-2">備考：</span><%= @invoice.note %>
        </div>
      <% end %>

      <% user = @invoice.user %>
      <% if user.bank_name.present? %>
        <div class="border-t border-gray-100 pt-4">
          <div class="text-xs text-gray-400 mb-3 tracking-wide">振込先</div>
          <div class="bg-gray-50 rounded-lg px-4 py-3 text-sm text-gray-700 space-y-1.5">
            <div><span class="text-xs text-gray-400 inline-block w-16">銀行名</span><%= user.bank_name %></div>
            <% if user.branch_name.present? %>
              <div><span class="text-xs text-gray-400 inline-block w-16">支店名</span><%= user.branch_name %></div>
            <% end %>
            <div><span class="text-xs text-gray-400 inline-block w-16">口座種別</span><%= user.account_type.presence || "普通" %></div>
            <% if user.account_number.present? %>
              <div><span class="text-xs text-gray-400 inline-block w-16">口座番号</span><%= user.account_number %></div>
            <% end %>
            <% if user.account_holder.present? %>
              <div><span class="text-xs text-gray-400 inline-block w-16">口座名義</span><%= user.account_holder %></div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="text-right text-sm text-gray-500 border-t border-gray-100 pt-4">
        <div class="font-medium text-gray-700"><%= @project.name %></div>
        <div class="text-xs text-gray-400 mt-1">環境整備事業</div>
      </div>

    </div>
  </div>
</div>

<style>
@media print {
  .no-print { display: none !important; }
  nav { display: none !important; }
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-scheme: light !important; }
  html, body { background: white !important; color: black !important; }
  #invoice-print { border: none !important; box-shadow: none !important; background: white !important; }
  #invoice-print * { background-color: revert !important; }
  .bg-gradient-to-r { background: #f0fdf4 !important; }
  .bg-gray-50 { background: #f9fafb !important; }
}
</style>
