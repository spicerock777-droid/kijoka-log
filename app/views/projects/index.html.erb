<% content_for :title, "現場一覧" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-2xl text-green-900">現場一覧</h1>
    <%= link_to "＋ 現場追加", new_project_path, class: "rounded-md px-4 py-2 bg-green-700 hover:bg-green-600 text-white text-sm font-medium" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "block bg-white rounded-lg border border-gray-200 p-5 shadow-sm hover:border-green-400 hover:shadow-md transition" do %>
        <h2 class="font-bold text-lg text-green-800"><%= project.name %></h2>
        <p class="text-sm text-gray-500 mt-1"><%= project.construction_records.count %>件の記録</p>
      <% end %>
    <% end %>
  </div>
</div>
