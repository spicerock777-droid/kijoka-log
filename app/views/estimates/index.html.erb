<% content_for :title, "見積書一覧" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-2xl text-green-900">見積書一覧</h1>
  </div>

  <%# 現場を選んで新規作成 %>
  <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
    <div class="text-sm font-medium text-green-800 mb-3">現場を選んで見積書を作成</div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <% @projects.each do |project| %>
        <%= link_to new_project_estimate_path(project),
            class: "flex items-center justify-center gap-1 rounded-md px-3 py-2.5 bg-white border border-green-300 text-sm font-medium text-green-800 hover:bg-green-100 active:bg-green-200 text-center" do %>
          <span>＋</span> <%= project.name %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# 検索 %>
  <%= form_with url: estimates_path, method: :get, class: "mb-6" do |f| %>
    <div class="flex gap-2">
      <%= f.text_field :q, value: params[:q], placeholder: "お客様名・件名で検索",
          class: "flex-1 border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-green-600" %>
      <%= f.submit "検索", class: "px-4 py-2 bg-green-700 text-white text-sm rounded-md hover:bg-green-600 cursor-pointer" %>
      <% if params[:q].present? %>
        <%= link_to "クリア", estimates_path, class: "px-4 py-2 bg-gray-100 text-gray-600 text-sm rounded-md hover:bg-gray-200" %>
      <% end %>
    </div>
  <% end %>

  <% if @estimates.empty? %>
    <p class="text-center my-10 text-gray-500">見積書がありません。</p>
  <% else %>
    <div class="space-y-3">
      <% @estimates.each do |estimate| %>
        <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs bg-green-100 text-green-800 px-2 py-0.5 rounded-full"><%= estimate.project.name %></span>
                <span class="text-xs text-gray-400"><%= estimate.doc_date.strftime("%Y年%-m月%-d日") %></span>
              </div>
              <div class="font-medium text-green-900"><%= estimate.client_name.presence || "（お客様名未入力）" %></div>
              <div class="text-sm text-gray-500 mt-0.5"><%= estimate.subject.presence || "（件名未入力）" %></div>
            </div>
            <div class="text-right flex-shrink-0 ml-4">
              <div class="font-bold text-green-800">¥<%= number_with_delimiter(estimate.grand_total) %></div>
              <%= link_to "詳細", project_estimate_path(estimate.project, estimate), class: "text-xs text-green-700 hover:underline" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
