<%= form_with(model: [@project, invoice]) do |f| %>
  <% if invoice.errors.any? %>
    <div class="bg-red-50 text-red-500 px-3 py-2 rounded-md mb-4 text-sm">
      <% invoice.errors.each do |e| %><div><%= e.full_message %></div><% end %>
    </div>
  <% end %>

  <div class="space-y-4">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :invoiced_on, "請求日", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :invoiced_on, class: "block w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm focus:outline-green-600" %>
      </div>
      <div>
        <%= f.label :due_date, "支払期限", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :due_date, class: "block w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm focus:outline-green-600" %>
      </div>
    </div>

    <div>
      <%= f.label :client_name, "お客様名", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :client_name, class: "block w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm focus:outline-green-600", placeholder: "山田太郎" %>
    </div>

    <div>
      <%= f.label :subject, "件名", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :subject, class: "block w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm focus:outline-green-600", placeholder: "水脈整備施工代" %>
    </div>

    <div>
      <%= f.label :amount, "請求金額（税込）", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :amount, min: 0, class: "block w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm focus:outline-green-600", placeholder: "123456" %>
    </div>

    <div>
      <%= f.label :note, "備考", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :note, rows: 2, class: "block w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm focus:outline-green-600" %>
    </div>
  </div>

  <div class="mt-6">
    <%= f.submit invoice.new_record? ? "保存する" : "更新する",
        class: "w-full rounded-md px-5 py-3 bg-green-700 hover:bg-green-600 text-white font-medium cursor-pointer text-base" %>
  </div>
<% end %>
