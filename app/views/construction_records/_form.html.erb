<%= form_with(model: [@project, construction_record], class: "contents") do |form| %>
  <% if construction_record.errors.any? %>
    <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <ul class="list-disc ml-6">
        <% construction_record.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :worked_on, "施工日", class: "block font-medium text-gray-700" %>
    <%= form.date_field :worked_on, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :site, "場所", class: "block font-medium text-gray-700" %>
    <%= form.text_field :site, placeholder: "例：南側斜面、池周辺", required: false, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :work_items, "施工内容", class: "block font-medium text-gray-700" %>
    <%= form.textarea :work_items, rows: 4, placeholder: "例：点穴を掘る、浅溝を調整する", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :intent, "意図・仮説", class: "block font-medium text-gray-700" %>
    <%= form.textarea :intent, rows: 4, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :observations, "施工後の観察", class: "block font-medium text-gray-700" %>
    <%= form.textarea :observations, rows: 4, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :next_steps, "次回への申し送り", class: "block font-medium text-gray-700" %>
    <%= form.textarea :next_steps, rows: 3, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
  </div>

  <div class="my-5 border-t border-gray-200 pt-5">
    <p class="font-medium text-gray-700 mb-3">費用</p>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :construction_cost, "施工経費（円）", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :construction_cost, min: 0, placeholder: "0", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
      </div>
      <div>
        <%= form.label :labor_cost, "人件費（円）", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :labor_cost, min: 0, placeholder: "0", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
      </div>
    </div>
    <div class="mt-3">
      <%= form.label :cost_memo, "費用メモ（内訳など）", class: "block text-sm font-medium text-gray-700" %>
      <%= form.textarea :cost_memo, rows: 2, placeholder: "例：資材代1,500円、作業員2名×3h", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full focus:outline-blue-600" %>
    </div>
  </div>

  <%# 既存写真のコメント・分類編集 %>
  <% if construction_record.photos.any? %>
    <div class="my-5">
      <p class="block font-medium text-gray-700 mb-2">写真コメント</p>
      <div class="grid grid-cols-2 gap-3">
        <% construction_record.photos.ordered.each do |photo| %>
          <div class="border border-gray-200 rounded-lg p-2">
            <%= image_tag photo_url(photo, width: 200, height: 200, crop: :limit), class: "w-full h-28 object-cover rounded mb-2" %>
            <div class="flex gap-1 mb-1.5">
              <% [["before", "ビフォー", "bg-blue-100 text-blue-700 border-blue-300"],
                  ["during", "作業中",  "bg-yellow-100 text-yellow-700 border-yellow-300"],
                  ["after",  "アフター","bg-green-100 text-green-700 border-green-300"]].each do |val, label, active_class| %>
                <label class="photo-type-label flex-1 text-center text-xs py-1 rounded border cursor-pointer
                              <%= photo.photo_type == val ? active_class : "bg-gray-50 text-gray-400 border-gray-200" %>">
                  <%= radio_button_tag "photo_updates[#{photo.id}][photo_type]", val, photo.photo_type == val, class: "hidden" %>
                  <%= label %>
                </label>
              <% end %>
            </div>
            <%= text_field_tag "photo_updates[#{photo.id}][caption]",
                  photo.caption,
                  placeholder: "コメントを入力",
                  class: "block w-full text-sm border border-gray-300 rounded px-2 py-1 focus:outline-blue-600" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# 新規写真アップロード %>
  <div class="my-5">
    <p class="block font-medium text-gray-700 mb-2">写真を追加（複数可）</p>
    <label class="flex items-center gap-2 cursor-pointer w-full rounded-md border-2 border-dashed border-gray-300 px-4 py-3 hover:border-green-400 bg-gray-50">
      <span class="text-sm text-green-700 font-medium">📷 写真を選ぶ</span>
      <span id="photo-count-label" class="text-xs text-gray-400"></span>
      <%= file_field_tag "new_photos[]", multiple: true, accept: "image/*", class: "hidden", id: "new-photos-input" %>
    </label>
    <p class="text-xs text-gray-400 mt-1">最大10枚まで</p>
    <div id="new-photos-preview" class="grid grid-cols-2 gap-3 mt-3"></div>
  </div>

  <div class="mt-6">
    <%= form.submit "保存する", class: "w-full sm:w-auto rounded-md px-5 py-2.5 bg-green-700 hover:bg-green-600 text-white font-medium cursor-pointer" %>
  </div>
<% end %>

<script>
  // 既存写真のタイプ切り替え
  document.querySelectorAll('.photo-type-label').forEach(label => {
    label.addEventListener('click', () => {
      const name = label.querySelector('input').name;
      document.querySelectorAll(`input[name="${name}"]`).forEach(input => {
        const lbl = input.closest('label');
        lbl.classList.remove('bg-blue-100','text-blue-700','border-blue-300','bg-yellow-100','text-yellow-700','border-yellow-300','bg-green-100','text-green-700','border-green-300');
        lbl.classList.add('bg-gray-50','text-gray-400','border-gray-200');
      });
      const classes = { before: ['bg-blue-100','text-blue-700','border-blue-300'], during: ['bg-yellow-100','text-yellow-700','border-yellow-300'], after: ['bg-green-100','text-green-700','border-green-300'] };
      label.classList.remove('bg-gray-50','text-gray-400','border-gray-200');
      label.classList.add(...classes[label.querySelector('input').value]);
    });
  });

  // 新規写真アップロード時のプレビュー＋タイプ選択
  const TYPE_CLASSES = {
    before: ['bg-blue-100','text-blue-700','border-blue-300'],
    during: ['bg-yellow-100','text-yellow-700','border-yellow-300'],
    after:  ['bg-green-100','text-green-700','border-green-300']
  };
  const TYPE_LABELS = { before: 'ビフォー', during: '作業中', after: 'アフター' };

  document.getElementById('new-photos-input').addEventListener('change', function() {
    const preview = document.getElementById('new-photos-preview');
    const countLabel = document.getElementById('photo-count-label');
    preview.innerHTML = '';
    const files = Array.from(this.files);
    countLabel.textContent = files.length > 0 ? files.length + '枚選択中' : '';

    files.forEach((file, i) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const card = document.createElement('div');
        card.className = 'border border-gray-200 rounded-lg p-2';

        const img = document.createElement('img');
        img.src = e.target.result;
        img.className = 'w-full h-28 object-cover rounded mb-2';
        card.appendChild(img);

        // タイプボタン
        const btnRow = document.createElement('div');
        btnRow.className = 'flex gap-1';
        ['before','during','after'].forEach(val => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = TYPE_LABELS[val];
          btn.dataset.val = val;
          btn.dataset.idx = i;
          btn.className = 'flex-1 text-center text-xs py-1 rounded border ' +
            (val === 'before' ? TYPE_CLASSES.before.join(' ') : 'bg-gray-50 text-gray-400 border-gray-200');
          btn.addEventListener('click', () => {
            btnRow.querySelectorAll('button').forEach(b => {
              b.className = 'flex-1 text-center text-xs py-1 rounded border bg-gray-50 text-gray-400 border-gray-200';
            });
            btn.className = 'flex-1 text-center text-xs py-1 rounded border ' + TYPE_CLASSES[val].join(' ');
            card.querySelector('input[type=hidden]').value = val;
          });
          btnRow.appendChild(btn);
        });
        card.appendChild(btnRow);

        // タイプ値を保持するhidden input
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'new_photo_types[]';
        hidden.value = 'before';
        card.appendChild(hidden);

        preview.appendChild(card);
      };
      reader.readAsDataURL(file);
    });
  });
</script>
