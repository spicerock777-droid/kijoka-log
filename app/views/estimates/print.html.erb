<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>御見積書 - <%= @estimate.subject %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body { font-family: 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif; background: white; color: #111; font-size: 11pt; }
    @page { size: A4 portrait; margin: 12mm; }

    .wrap { max-width: 180mm; margin: 0 auto; padding: 10mm; }

    /* タイトル */
    .doc-title { text-align: center; font-size: 20pt; font-weight: 700; letter-spacing: 0.4em; border-bottom: 2px solid #333; padding-bottom: 4mm; margin-bottom: 8mm; }
    .doc-subtitle { text-align: center; font-size: 8pt; letter-spacing: 0.2em; color: #666; margin-bottom: 6mm; }

    /* メタ情報 */
    .meta { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 8mm; }
    .client-label { font-size: 8pt; color: #666; margin-bottom: 1mm; }
    .client-name { font-size: 14pt; font-weight: 700; border-bottom: 1.5px solid #333; padding-bottom: 1mm; min-width: 60mm; }
    .issuer { text-align: right; font-size: 9pt; line-height: 1.8; color: #444; }
    .issuer .co { font-size: 11pt; font-weight: 700; color: #111; }

    /* 件名 */
    .subject { border-left: 3px solid #555; padding-left: 4mm; margin-bottom: 8mm; }
    .subject .lbl { font-size: 8pt; color: #666; }
    .subject .val { font-size: 11pt; font-weight: 700; }

    /* 明細 */
    .items { width: 100%; margin-bottom: 6mm; border-collapse: collapse; }
    .items .header { border-bottom: 1.5px solid #333; padding-bottom: 2mm; display: flex; justify-content: space-between; font-size: 8pt; font-weight: 700; color: #555; margin-bottom: 1mm; }
    .item { border-bottom: 1px solid #e5e5e5; padding: 3mm 0; }
    .item-main { display: flex; justify-content: space-between; align-items: baseline; gap: 4mm; }
    .item-desc { font-size: 11pt; font-weight: 600; }
    .item-amt { font-size: 11pt; font-weight: 700; white-space: nowrap; }
    .item-note { font-size: 8pt; color: #666; margin-top: 0.5mm; }
    .item-detail { font-size: 8.5pt; color: #555; border-left: 2px solid #ccc; padding-left: 3mm; margin-top: 1mm; display: flex; justify-content: space-between; }

    /* 合計 */
    .totals { display: flex; justify-content: flex-end; margin-bottom: 8mm; }
    .totals table { border-collapse: collapse; min-width: 55mm; }
    .totals td { padding: 2mm 3mm; font-size: 9.5pt; }
    .totals td:last-child { text-align: right; }
    .totals .subtotal-row { border-bottom: 1px solid #ddd; }
    .totals .grand-row td { font-size: 13pt; font-weight: 700; border-top: 2px solid #333; padding-top: 3mm; }

    /* 備考 */
    .note { border: 1px solid #ddd; border-radius: 4px; padding: 4mm; font-size: 9pt; line-height: 1.8; color: #444; }
    .note-label { font-size: 8pt; font-weight: 700; color: #666; margin-bottom: 2mm; }
  </style>
</head>
<body>
<div class="wrap">

  <div class="doc-subtitle">ESTIMATE</div>
  <div class="doc-title">御　見　積　書</div>

  <div class="meta">
    <div>
      <div class="client-label">お客様名</div>
      <div class="client-name"><%= @estimate.client_name.presence || "　" %>　様</div>
    </div>
    <div class="issuer">
      <div class="co">長島開発</div>
      <div>見積日：<strong><%= @estimate.doc_date.strftime("%Y年%-m月%-d日") %></strong></div>
      <div>有効期限：発行日より30日間</div>
      <% if @estimate.doc_number.present? %>
        <div>見積番号：<%= @estimate.doc_number %></div>
      <% end %>
      <div>現場：<strong><%= @project.name %></strong></div>
    </div>
  </div>

  <% if @estimate.subject.present? %>
    <div class="subject">
      <div class="lbl">件名</div>
      <div class="val"><%= @estimate.subject %></div>
    </div>
  <% end %>

  <div>
    <div class="header"><span>施工内容</span><span>金額</span></div>
    <% @estimate.items.each do |item| %>
      <% qty = item["qty"].to_f; price = item["unit_price"].to_f %>
      <% unit_prices = item["unit_prices"] %>
      <% multi = unit_prices.present? && unit_prices.length > 1 %>
      <% amt = multi ? unit_prices.sum { |p| p.to_f.round } : (qty * price).round %>
      <% mats = item["materials"].presence || (item["material_name"].present? ? [{"name"=>item["material_name"],"cost"=>item["material_cost"]}] : []) %>
      <% mats = mats.select { |m| m["name"].present? || m["cost"].to_i > 0 } %>
      <div class="item">
        <div class="item-main">
          <span class="item-desc"><%= item["description"] %><% if item["note"].present? %><span style="font-size:8.5pt; font-weight:400; color:#666;">　（<%= item["note"] %>）</span><% end %></span>
          <span class="item-amt"><%= amt > 0 ? "¥#{number_with_delimiter(amt)}" : "" %></span>
        </div>
        <% unless multi %>
          <% if qty > 0 || price > 0 %>
            <div class="item-detail">
              <span><%= qty > 0 ? "#{qty % 1 == 0 ? qty.to_i : qty} #{item["unit"]}" : "" %></span>
              <span><%= price > 0 ? "¥#{number_with_delimiter(price.to_i)}" : "" %></span>
            </div>
          <% end %>
        <% end %>
        <% if multi %>
          <% unit_prices.each_with_index do |p, i| %>
            <div class="item-detail">
              <span>人工<%= %w[① ② ③ ④ ⑤ ⑥ ⑦ ⑧ ⑨ ⑩][i] %></span>
              <span>¥<%= number_with_delimiter(p.to_f.round) %></span>
            </div>
          <% end %>
        <% end %>
        <% mats.each do |m| %>
          <div class="item-detail" style="border-left-color:#aaa;">
            <span><%= m["name"].presence || "—" %><%= m["qty"].present? ? "　#{m["qty"]}" : "" %></span>
            <span><%= m["cost"].to_i > 0 ? "¥#{number_with_delimiter(m["cost"].to_i)}" : "" %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="totals">
    <table>
      <tr class="subtotal-row">
        <td style="color:#666;">施工費小計</td>
        <td>¥<%= number_with_delimiter(@estimate.work_subtotal) %></td>
      </tr>
      <% if @estimate.material_subtotal > 0 %>
        <tr class="subtotal-row">
          <td style="color:#666;">資材費小計</td>
          <td>¥<%= number_with_delimiter(@estimate.material_subtotal) %></td>
        </tr>
      <% end %>
      <% if @estimate.apply_tax %>
        <tr class="subtotal-row">
          <td style="color:#666;">消費税（10%）</td>
          <td>¥<%= number_with_delimiter(@estimate.tax) %></td>
        </tr>
      <% end %>
      <tr class="grand-row">
        <td>合計金額</td>
        <td>¥<%= number_with_delimiter(@estimate.grand_total) %></td>
      </tr>
    </table>
  </div>

  <% if @estimate.note.present? %>
    <div class="note">
      <div class="note-label">備考・条件</div>
      <div><%= simple_format @estimate.note %></div>
    </div>
  <% end %>

</div>
<div id="after-print" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:100; display:none; align-items:center; justify-content:center;">
  <div style="background:white; border-radius:12px; padding:32px 40px; text-align:center; max-width:340px; width:90%;">
    <div style="font-size:28px; margin-bottom:12px;">✅</div>
    <div style="font-size:15px; font-weight:700; margin-bottom:6px;">PDF保存完了</div>
    <div style="font-size:12px; color:#666; margin-bottom:24px;">LINEで見積リンクを送りますか？</div>
    <a href="https://line.me/R/msg/text/?<%= CGI.escape("【御見積書】\n現場：#{@project.name}\n#{@estimate.subject}\n合計：¥#{number_with_delimiter(@estimate.grand_total)}\n\n詳細はこちら：#{public_share_url("/e/#{@estimate.share_token}")}") %>"
       target="_blank"
       style="display:block; background:#06C755; color:white; text-decoration:none; padding:12px 0; border-radius:8px; font-size:15px; font-weight:700; margin-bottom:10px;">
      LINEで送る
    </a>
    <button onclick="window.close()" style="width:100%; padding:10px 0; border:1px solid #ddd; border-radius:8px; background:white; color:#666; font-size:13px; cursor:pointer;">
      閉じる
    </button>
  </div>
</div>

<script>
  window.onload = function() { window.print(); }
  window.onafterprint = function() {
    document.getElementById('after-print').style.display = 'flex';
  }
</script>
</body>
</html>
