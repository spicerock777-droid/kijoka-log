<% content_for :title, "設定" %>

<div class="w-full max-w-lg">
  <h1 class="text-lg font-medium text-gray-700 mb-6">設定</h1>

  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-600 font-medium rounded-md text-sm"><%= notice %></p>
  <% end %>

  <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-6" do |f| %>

    <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6 space-y-4">
      <h2 class="text-sm font-medium text-gray-500 tracking-wide border-b border-gray-100 pb-3">振込先情報</h2>
      <p class="text-xs text-gray-400">請求書に表示される振込先です。</p>

      <div>
        <%= f.label :bank_name, "銀行名", class: "block text-xs text-gray-500 mb-1" %>
        <%= f.text_field :bank_name, placeholder: "例：○○銀行", class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-400" %>
      </div>

      <div>
        <%= f.label :branch_name, "支店名", class: "block text-xs text-gray-500 mb-1" %>
        <%= f.text_field :branch_name, placeholder: "例：○○支店", class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-400" %>
      </div>

      <div>
        <%= f.label :account_type, "口座種別", class: "block text-xs text-gray-500 mb-1" %>
        <%= f.select :account_type, [["普通", "普通"], ["当座", "当座"]], {}, class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-400" %>
      </div>

      <div>
        <%= f.label :account_number, "口座番号", class: "block text-xs text-gray-500 mb-1" %>
        <%= f.text_field :account_number, placeholder: "例：1234567", class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-400" %>
      </div>

      <div>
        <%= f.label :account_holder, "口座名義（カタカナ）", class: "block text-xs text-gray-500 mb-1" %>
        <%= f.text_field :account_holder, placeholder: "例：ヤマダ タロウ", class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-400" %>
      </div>
    </div>

    <%= f.submit "保存する", class: "w-full py-2.5 bg-green-700 text-white text-sm font-medium rounded-lg hover:bg-green-600 cursor-pointer" %>

  <% end %>
</div>
