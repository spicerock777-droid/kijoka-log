<% content_for :title, "場所別ギャラリー - #{@project.name}" %>

<div class="w-full">
  <div class="mb-6">
    <%= link_to "← #{@project.name}", project_path(@project), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="font-bold text-2xl text-green-900 mt-1">場所別ギャラリー</h1>
  </div>

  <% if @records_by_site.empty? %>
    <p class="text-center my-10 text-gray-500">写真つきの施工記録がありません。</p>
  <% else %>
    <% @records_by_site.each do |site, records| %>
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-4 border-b border-green-200 pb-2">
          <h2 class="text-lg font-bold text-green-900"><%= site %></h2>
          <span class="text-xs text-gray-400"><%= records.count %>回の記録</span>
        </div>

        <div class="flex gap-4 overflow-x-auto pb-3">
          <% records.each_with_index do |record, i| %>
            <div class="flex-none w-48">
              <div class="relative mb-2">
                <% if i == 0 %>
                  <span class="absolute top-2 left-2 z-10 bg-blue-600 text-white text-xs px-2 py-0.5 rounded-full">はじめ</span>
                <% elsif i == records.size - 1 && records.size > 1 %>
                  <span class="absolute top-2 left-2 z-10 bg-orange-500 text-white text-xs px-2 py-0.5 rounded-full">最新</span>
                <% end %>
                <% record.photos.each do |photo| %>
                  <%= link_to project_construction_record_path(@project, record) do %>
                    <%= image_tag photo_url(photo, width: 200, height: 150), class: "w-48 h-36 object-cover rounded-lg border border-gray-200 mb-1 block", loading: "lazy" %>
                  <% end %>
                <% end %>
              </div>
              <p class="text-xs font-medium text-green-800"><%= record.worked_on.strftime("%Y年%-m月%-d日") %></p>
              <% if record.work_items.present? %>
                <p class="text-xs text-gray-500 mt-0.5 leading-snug"><%= record.work_items.truncate(40) %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
