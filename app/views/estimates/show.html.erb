<% content_for :title, "見積書 - #{@estimate.subject}" %>


<div class="w-full max-w-3xl">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-500 font-medium rounded-md inline-block"><%= notice %></p>
  <% end %>

  <%# 共有リンク期限 %>
  <% if @estimate.share_token_expires_at.present? %>
    <% days_left = (@estimate.share_token_expires_at.to_date - Date.today).to_i %>
    <div class="no-print mb-3 flex items-center gap-3 text-xs">
      <% if days_left > 7 %>
        <span class="text-gray-400">共有リンク有効期限：<span class="text-gray-600"><%= @estimate.share_token_expires_at.strftime("%Y年%-m月%-d日") %>（残り<%= days_left %>日）</span></span>
      <% elsif days_left > 0 %>
        <span class="text-orange-500 font-medium">共有リンク残り<%= days_left %>日で期限切れ</span>
      <% else %>
        <span class="text-red-500 font-medium">共有リンク期限切れ</span>
      <% end %>
      <%= button_to "30日延長", extend_share_project_estimate_path(@project, @estimate), method: :patch, class: "px-2 py-0.5 bg-gray-100 hover:bg-gray-200 rounded text-gray-600 cursor-pointer" %>
    </div>
  <% end %>

  <div class="mb-4 flex items-center justify-between">
    <div>
      <%= link_to "← #{@project.name}", project_path(@project), class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
    <div class="flex gap-2 no-print">
      <%= link_to "編集", edit_project_estimate_path(@project, @estimate), class: "text-sm px-3 py-1.5 bg-gray-100 hover:bg-gray-200 rounded-md" %>
      <%= button_to "削除", project_estimate_path(@project, @estimate), method: :delete, class: "text-sm px-3 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-md cursor-pointer", data: { turbo_confirm: "この見積書を削除しますか？" } %>
    </div>
  </div>

  <%# テーマ切替（印刷非表示） %>
  <div class="no-print flex gap-2 mb-3 items-center">
    <span class="text-xs text-gray-400">背景：</span>
    <button onclick="setTheme('aqua')"   data-theme="aqua"   class="theme-btn text-xs px-3 py-1 rounded-full border border-teal-300 text-teal-700 hover:bg-teal-50">珊瑚・浅瀬</button>
    <button onclick="setTheme('sunset')" data-theme="sunset" class="theme-btn text-xs px-3 py-1 rounded-full border border-orange-300 text-orange-700 hover:bg-orange-50">南国の夕方</button>
    <button onclick="setTheme('forest')" data-theme="forest" class="theme-btn text-xs px-3 py-1 rounded-full border border-green-400 text-green-700 hover:bg-green-50">亜熱帯の緑</button>
  </div>

  <%# 見積書本体（印刷用） %>
  <div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden" id="estimate-print" style="-webkit-print-color-adjust: exact; print-color-adjust: exact;">

    <%# タイトル %>
    <div class="text-center pt-8 pb-6 px-10" id="estimate-title">
      <p class="text-xs tracking-widest text-gray-400 mb-2">ESTIMATE</p>
      <h1 class="text-2xl font-medium text-gray-700" style="font-family: 'Shippori Mincho', serif; letter-spacing: 0.5em;">御　見　積　書</h1>
      <div class="mt-3 flex items-center gap-3 justify-center">
        <div class="h-px flex-1 bg-gray-300 opacity-40"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-gray-400 opacity-40"></div>
        <div class="h-px flex-1 bg-gray-300 opacity-40"></div>
      </div>
    </div>
    <div class="px-10 pb-10 pt-6">

    <%# 宛先・発行情報 %>
    <div class="flex justify-between items-end mb-8">
      <div>
        <div class="text-sm text-gray-600 font-medium mb-1.5 tracking-wide">お客様名</div>
        <div class="text-xl font-bold text-gray-900 border-b border-gray-400 pb-1.5 min-w-52">
          <%= @estimate.client_name.presence || "　" %>　様
        </div>
      </div>
      <div class="text-sm text-gray-600 font-medium space-y-1.5 text-right">
        <div class="text-base font-bold text-gray-900 mb-1">長島開発</div>
        <div>見積日：<span class="text-gray-800 font-semibold"><%= @estimate.doc_date.strftime("%Y年%-m月%-d日") %></span></div>
        <div>有効期限：<span class="text-gray-700">発行日より30日間</span></div>
        <% if @estimate.doc_number.present? %>
          <div>見積番号：<span class="text-gray-800"><%= @estimate.doc_number %></span></div>
        <% end %>
        <div>現場：<span class="text-gray-900 font-bold"><%= @project.name %></span></div>
      </div>
    </div>

    <% if @estimate.subject.present? %>
      <div class="border-l-2 border-gray-300 pl-4 mb-8 py-0.5">
        <span class="text-sm text-gray-600 font-medium">件名</span>
        <div class="text-base font-semibold text-gray-800 mt-0.5"><%= @estimate.subject %></div>
      </div>
    <% end %>

    <%# 明細 %>
    <div class="mb-8">
      <div class="flex justify-between pb-2.5 border-b border-gray-300 text-sm text-gray-600 font-semibold tracking-wider">
        <span>施工内容</span>
        <span>金額</span>
      </div>
      <% @estimate.items.each do |item| %>
        <% qty = item["qty"].to_f; price = item["unit_price"].to_f %>
        <% unit_prices = item["unit_prices"] %>
        <% multi = unit_prices.present? && unit_prices.length > 1 %>
        <% amt = multi ? unit_prices.sum { |p| p.to_f.round } : (qty * price).round %>
        <% mats = item["materials"].presence || (item["material_name"].present? ? [{"name"=>item["material_name"],"cost"=>item["material_cost"]}] : []) %>
        <% mats = mats.select { |m| m["name"].present? || m["cost"].to_i > 0 } %>
        <div class="py-3.5 border-b border-gray-100">
          <div class="flex justify-between items-baseline gap-4">
            <span class="text-base text-gray-800 font-semibold"><%= item["description"] %></span>
            <span class="text-base font-bold text-gray-900 flex-shrink-0"><%= amt > 0 ? "¥#{number_with_delimiter(amt)}" : "" %></span>
          </div>
          <% if item["note"].present? %>
            <div class="mt-0.5 text-sm text-gray-500 italic"><%= item["note"] %></div>
          <% end %>
          <div class="mt-1.5 space-y-0.5">
            <% unless multi %>
              <% if qty > 0 || price > 0 %>
                <div class="flex justify-between text-sm text-gray-600 border-l border-gray-300 pl-2.5">
                  <span><%= qty > 0 ? "#{qty % 1 == 0 ? qty.to_i : qty} #{item["unit"]}" : "" %></span>
                  <span><%= price > 0 ? "¥#{number_with_delimiter(price.to_i)}" : "" %></span>
                </div>
              <% end %>
            <% end %>
            <% if multi %>
              <% unit_prices.each_with_index do |p, i| %>
                <div class="flex justify-between text-sm text-gray-600 border-l border-gray-300 pl-2.5">
                  <span>人工<%= %w[① ② ③ ④ ⑤ ⑥ ⑦ ⑧ ⑨ ⑩][i] %></span>
                  <span>¥<%= number_with_delimiter(p.to_f.round) %></span>
                </div>
              <% end %>
            <% end %>
            <% mats.each do |m| %>
              <div class="flex justify-between text-sm text-gray-600 border-l border-stone-400 pl-2.5">
                <span><%= m["name"].presence || "—" %><%= m["qty"].present? ? "　#{m["qty"]}" : "" %></span>
                <span><%= m["cost"].to_i > 0 ? "¥#{number_with_delimiter(m["cost"].to_i)}" : "" %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# 合計 %>
    <div class="flex justify-end mb-8">
      <table class="text-sm w-60">
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-6 text-gray-600 font-medium">施工費小計</td>
          <td class="py-2 text-right text-gray-800 font-semibold">¥<%= number_with_delimiter(@estimate.work_subtotal) %></td>
        </tr>
        <% if @estimate.material_subtotal > 0 %>
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-6 text-gray-600 font-medium">資材費小計</td>
            <td class="py-2 text-right text-gray-800 font-semibold">¥<%= number_with_delimiter(@estimate.material_subtotal) %></td>
          </tr>
        <% end %>
        <% if @estimate.apply_tax %>
          <tr class="border-b border-gray-200">
            <td class="py-2 pr-6 text-gray-600 font-medium">消費税（10%）</td>
            <td class="py-2 text-right text-gray-800 font-semibold">¥<%= number_with_delimiter(@estimate.tax) %></td>
          </tr>
        <% end %>
        <tr>
          <td class="pt-4 pr-6 text-gray-700 font-medium tracking-wide" style="letter-spacing: 0.1em;">合　計　金　額</td>
          <td class="pt-4 text-right text-2xl font-bold text-gray-800">¥<%= number_with_delimiter(@estimate.grand_total) %></td>
        </tr>
      </table>
    </div>

    <% if @estimate.note.present? %>
      <div class="border-t border-gray-100 pt-6 text-sm text-gray-700">
        <div class="text-sm text-gray-600 font-medium mb-2 tracking-wide">備考・条件</div>
        <p class="whitespace-pre-wrap leading-relaxed"><%= @estimate.note %></p>
      </div>
    <% end %>

    </div><%# /px-10 pb-10 %>
  </div>

  <%# アクションボタン %>
  <div id="action-buttons" style="margin-top:16px;display:flex;flex-wrap:wrap;gap:8px">
    <%= link_to "請求書を作成",
          new_project_invoice_path(@project,
            client_name: @estimate.client_name,
            amount:      @estimate.grand_total,
            subject:     @estimate.subject),
          style: "font-size:14px;padding:8px 12px;background:#d1fae5;color:#065f46;border-radius:6px;text-decoration:none" %>
    <%= link_to "領収書を作成",
          new_project_receipt_path(@project,
            client_name: @estimate.client_name,
            amount:      @estimate.grand_total,
            tadashi:     "#{@estimate.subject}施工代として"),
          style: "font-size:14px;padding:8px 12px;background:#e7e5e4;color:#44403c;border-radius:6px;text-decoration:none" %>
    <button onclick="window.print()" style="font-size:14px;padding:8px 12px;background:#15803d;color:white;border-radius:6px;cursor:pointer;border:none">印刷</button>
    <button onclick="downloadPdf(this,'estimate-print','御見積書_<%= j @estimate.subject %>_<%= @estimate.doc_date.strftime("%Y%m%d") %>')" style="font-size:14px;padding:8px 12px;background:#4f46e5;color:white;border-radius:6px;cursor:pointer;border:none">PDFダウンロード</button>
    <%= link_to "LINEで送る",
          "https://line.me/R/msg/text/?text=#{CGI.escape("【御見積書】\n現場：#{@project.name}\n#{@estimate.subject}\n合計：¥#{number_with_delimiter(@estimate.grand_total)}\n\n詳細はこちら：#{request.base_url}/e/#{@estimate.share_token}")}",
          target: "_blank",
          style: "font-size:14px;padding:8px 12px;background:#22c55e;color:white;border-radius:6px;text-decoration:none" %>
    <%= link_to "Gmailで送る",
          "https://mail.google.com/mail/?view=cm&fs=1&su=#{CGI.escape("【御見積書】#{@estimate.subject}")}&body=#{CGI.escape("#{@estimate.client_name.presence || ""}様\n\n御見積書をお送りします。\n\n現場：#{@project.name}\n件名：#{@estimate.subject}\n合計金額：¥#{number_with_delimiter(@estimate.grand_total)}\n\n詳細はこちらからご確認ください：\n#{request.base_url}/e/#{@estimate.share_token}\n\nよろしくお願いいたします。")}",
          target: "_blank",
          style: "font-size:14px;padding:8px 12px;background:#3b82f6;color:white;border-radius:6px;text-decoration:none" %>
  </div>

</div>

<style>

  #estimate-print.theme-aqua   { background: linear-gradient(150deg, #daf4f2 0%, #f0fbf9 50%, #e4f8f5 100%); outline: 1.5px solid rgba(80,190,185,0.35); outline-offset: -10px; border-color: #a8dedd !important; }
  #estimate-print.theme-sunset { background: linear-gradient(150deg, #fdeee0 0%, #fdfaf3 55%, #fef3e4 100%); outline: 1.5px solid rgba(220,150,100,0.35); outline-offset: -10px; border-color: #f0c4a0 !important; }
  #estimate-print.theme-forest { background: linear-gradient(150deg, #f4fbf5 0%, #ffffff 50%, #f2fbf3 100%); outline: 1.5px solid rgba(100,180,110,0.25); outline-offset: -10px; border-color: #c8e8cc !important; }
@media print {
  .no-print { display: none !important; }
  #action-buttons { display: none !important; }
  nav { display: none !important; }
  body { background: white; margin: 0; padding: 0; font-size: 11px; }
  @page { size: A4 portrait; margin: 8mm; }
  #estimate-print {
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
  }
  #estimate-print h1 { font-size: 18px !important; }
  #estimate-print .px-10 { padding-left: 16px !important; padding-right: 16px !important; }
  #estimate-print .pt-8 { padding-top: 12px !important; }
  #estimate-print .pb-10 { padding-bottom: 12px !important; }
  #estimate-print .py-3\.5 { padding-top: 6px !important; padding-bottom: 6px !important; break-inside: avoid; }
  #estimate-print .mb-8 { margin-bottom: 10px !important; }
  #estimate-print .text-2xl { font-size: 16px !important; }
  table { break-inside: avoid; }
}
</style>
<script>
  function setTheme(name) {
    const el = document.getElementById('estimate-print')
    el.className = el.className.replace(/theme-\w+/g, '')
    el.classList.add('theme-' + name)
    localStorage.setItem('estimate-theme', name)
    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.classList.toggle('ring-2', btn.dataset.theme === name)
      btn.classList.toggle('ring-offset-1', btn.dataset.theme === name)
    })
  }
  function applyTheme() {
    const saved = localStorage.getItem('estimate-theme') || 'aqua'
    setTheme(saved)
  }
  document.addEventListener('turbo:load', applyTheme)
  document.addEventListener('DOMContentLoaded', applyTheme)
</script>
<script src="/html2pdf.bundle.min.js"></script>
<script>
  function downloadPdf(btn, elementId, filename) {
    const el = document.getElementById(elementId)
    btn.textContent = '生成中...'
    btn.disabled = true
    html2pdf().set({
      margin: 8,
      filename: filename + '.pdf',
      image: { type: 'jpeg', quality: 0.95 },
      html2canvas: {
        scale: 2,
        useCORS: false,
        allowTaint: true,
        logging: false,
        onclone: function(doc) {
          doc.querySelectorAll('link[href*="fonts.googleapis"], link[href*="fonts.gstatic"]').forEach(el => el.remove())
        }
      },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    }).from(el).save().then(() => {
      btn.textContent = 'PDFダウンロード'
      btn.disabled = false
    }).catch(() => {
      btn.textContent = 'PDFダウンロード'
      btn.disabled = false
      alert('PDF生成に失敗しました。印刷ボタンからPDF保存をお試しください。')
    })
  }
</script>
