<div id="<%= dom_id construction_record %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Worked on:</strong>
    <%= construction_record.worked_on %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Site:</strong>
    <%= construction_record.site %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Work items:</strong>
    <%= construction_record.work_items %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Intent:</strong>
    <%= construction_record.intent %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Observations:</strong>
    <%= construction_record.observations %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Next steps:</strong>
    <%= construction_record.next_steps %>
  </div>
</div>
